# Copy to .env.development or .env.production
# true = use the mock API in src/mocks (no backend needed)
VITE_USE_MOCKS=true
# Daiyrbek's Java API base URL
VITE_API_URL=http://localhost:8080/api/v1
# Time zone of the demo city (SRS 8.5)
VITE_TIME_ZONE=America/New_York
# Show "Simulate upgrade" on the Plus page when Stripe is not ready (FR-PAY-3)
VITE_DEMO_UPGRADE=true
# Google sign-in client ID (FR-AUTH-6); leave empty to hide the button
VITE_GOOGLE_CLIENT_ID=
